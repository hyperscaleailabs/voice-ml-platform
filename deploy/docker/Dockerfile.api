# syntax=docker/dockerfile:1.7
# Voice agent API. Build from the repository root:
#   docker build -f deploy/docker/Dockerfile.api -t vmp-api:dev .
# Default backend is `echo` (no model weights). Override CMD or set
# VMP_LLM_BACKEND to point at ollama / an OpenAI-compatible server.
# Build arg EXTRAS selects the optional dependency sets, e.g.
#   --build-arg EXTRAS=serve,obs,features   for the Feast materialize CronJob.

ARG PY_TAG=3.12-slim
FROM python:${PY_TAG} AS build
ARG EXTRAS=serve,obs
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1
WORKDIR /src
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
COPY configs ./configs
RUN python -m venv /opt/venv \
 && /opt/venv/bin/pip install --upgrade pip \
 && /opt/venv/bin/pip install ".[${EXTRAS}]"

FROM python:${PY_TAG} AS runtime
ENV PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    VMP_TRACE_PATH=/var/lib/vmp/trace.jsonl \
    VMP_REGISTRY_ROOT=/var/lib/vmp/registry \
    VMP_RAG_INDEX_ROOT=/var/lib/vmp/rag \
    VMP_EDGE_BUNDLE_ROOT=/var/lib/vmp/edge \
    VMP_FEATURE_STORE_ROOT=/var/lib/vmp/features
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates tini \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --gid 10001 vmp \
 && useradd --uid 10001 --gid vmp --home-dir /app --create-home --shell /usr/sbin/nologin vmp \
 && mkdir -p /var/lib/vmp && chown -R vmp:vmp /var/lib/vmp
COPY --from=build --chown=vmp:vmp /opt/venv /opt/venv
COPY --chown=vmp:vmp configs /app/configs
WORKDIR /app
USER 10001:10001
EXPOSE 8080
VOLUME ["/var/lib/vmp"]
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8080/healthz || exit 1
ENTRYPOINT ["tini", "--"]
CMD ["vmp", "serve", "api", "--host", "0.0.0.0", "--port", "8080", "--backend", "echo"]
